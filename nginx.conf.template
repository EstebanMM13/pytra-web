server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;
    root /usr/share/nginx/html;

    gzip on;
    gzip_vary on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Security headers. nginx does NOT inherit add_header into a location that
    # declares its own add_header, so every location below repeats them.
    # CSP notes:
    #  - script-src 'self': the build emits no inline scripts (inlineCritical is
    #    disabled in angular.json for that reason).
    #  - style-src 'unsafe-inline': Angular injects component styles as <style> tags.
    #  - img-src https:: game cover URLs are user-provided / external hosts.
    #  - connect-src: the API lives on its own origin.
    set $csp "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://pytra-api-production.up.railway.app; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'";
    # The service worker re-fetches every request the page makes (game covers from
    # Steam's CDN included), and a worker is bound by the CSP of its own script.
    # So its connect-src must allow any https origin, like the page's img-src does.
    set $csp_worker "default-src 'self'; script-src 'self'; connect-src 'self' https:; object-src 'none'; base-uri 'self'";

    # Service worker files must never be cached by the browser/proxies, otherwise
    # clients keep running an old worker and never see new versions. These exact
    # matches win over the hashed-assets regex below. worker-src falls back to
    # script-src 'self', so the CSP already allows the worker.
    location = /ngsw-worker.js {
        try_files $uri =404;
        add_header Cache-Control "no-cache";
        add_header Content-Security-Policy $csp_worker always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    }

    location = /safety-worker.js {
        try_files $uri =404;
        add_header Cache-Control "no-cache";
        add_header Content-Security-Policy $csp_worker always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    }

    location = /ngsw.json {
        try_files $uri =404;
        add_header Cache-Control "no-cache";
        add_header Content-Security-Policy $csp always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    }

    location = /manifest.webmanifest {
        try_files $uri =404;
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
        add_header Content-Security-Policy $csp always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    }

    # Angular emits content-hashed JS/CSS, so those can be cached aggressively.
    location ~* \.(?:js|css)$ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header Content-Security-Policy $csp always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    }

    # SPA fallback: unknown routes go to index.html (never cached).
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        add_header Content-Security-Policy $csp always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    }
}
